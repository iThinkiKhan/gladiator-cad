+import android.view.Gravity
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.TextView
+import com.facebook.react.bridge.LifecycleEventListener
+import com.facebook.react.common.LifecycleState
+import com.facebook.react.uimanager.SimpleViewManager
+import com.facebook.react.uimanager.ThemedReactContext
+import com.facebook.react.uimanager.annotations.ReactProp
+import java.io.BufferedInputStream
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicReference
+
+class GladiatorCameraView(context: ThemedReactContext) : FrameLayout(context), LifecycleEventListener {
+  private val reactContext = context
+  private val image = ImageView(context).apply { scaleType = ImageView.ScaleType.FIT_CENTER }
+  private val status = TextView(context).apply {
+    setTextColor(Color.WHITE); textSize = 12f
+    setBackgroundColor(0xB0000000.toInt()); setPadding(12, 6, 12, 6)
+    text = "Camera stopped"
+  }
+  private val main = Handler(Looper.getMainLooper())
+  private val generation = AtomicInteger()
+  private val connection = AtomicReference<HttpURLConnection?>()
+  private val pending = AtomicReference<Bitmap?>()
+  private val deliveryQueued = java.util.concurrent.atomic.AtomicBoolean(false)
+  private var active = false
+
+  init {
+    setBackgroundColor(Color.BLACK)
+    addView(image, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
+    addView(status, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT, Gravity.TOP or Gravity.START))
+    reactContext.addLifecycleEventListener(this)
+  }
+
+  fun setActive(next: Boolean) {
+    if (!next) { stop(); return }
+    if (active || reactContext.lifecycleState != LifecycleState.RESUMED) return
+    active = true
+    val token = generation.incrementAndGet()
+    status.text = "Connecting to camera..."
+    Thread({ stream(token) }, "gladiator-camera").apply { isDaemon = true; start() }
+  }
+
+  private fun stream(token: Int) {
+    var socket: HttpURLConnection? = null
+    try {
+      // Route only this socket over C6 Wi-Fi, even if Android prefers cellular
+      // or Spectre has bound other traffic to a different process network.
+      val networks = reactContext.getSystemService(android.content.Context.CONNECTIVITY_SERVICE) as ConnectivityManager
+      val wifi = networks.allNetworks.firstOrNull { network ->
+        networks.getNetworkCapabilities(network)?.hasTransport(NetworkCapabilities.TRANSPORT_WIFI) == true &&
+          networks.getLinkProperties(network)?.linkAddresses?.any { it.address.hostAddress?.startsWith("192.168.8.") == true } == true
+      } ?: throw java.io.IOException("Join Gladiator-Gateway Wi-Fi")
+      socket = wifi.openConnection(URL("http://192.168.8.2:81/stream")) as HttpURLConnection
+      socket.instanceFollowRedirects = false
+      socket.connectTimeout = 2000; socket.readTimeout = 1500; socket.useCaches = false
+      socket.setRequestProperty("Accept", "multipart/x-mixed-replace")
+      connection.set(socket)
+      if (generation.get() != token) return
+      if (socket.responseCode != 200) throw java.io.IOException("Camera unavailable")
+      BufferedInputStream(socket.inputStream, 16384).use { input ->
+        val reader = MjpegReader(input, socket.contentType)
+        while (generation.get() == token) {
+          val bytes = reader.readFrame()
+          val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+          BitmapFactory.decodeByteArray(bytes, 0, bytes.size, bounds)
+          if (bounds.outWidth <= 0 || bounds.outHeight <= 0 || bounds.outWidth.toLong()*bounds.outHeight > 1048576)
+            throw java.io.IOException("Invalid camera dimensions")
+          val bitmap = BitmapFactory.decodeByteArray(bytes, 0, bytes.size)
+              ?: throw java.io.IOException("Invalid JPEG")
+          if (generation.get() != token) return
+          pending.set(bitmap) // Latest frame only; never queue a video backlog.
+          if (deliveryQueued.compareAndSet(false, true)) main.post {
+            deliveryQueued.set(false)
+            val latest = pending.getAndSet(null)
+            if (generation.get() == token && latest != null) {
+              image.setImageBitmap(latest); status.text = "LIVE"
+            }
+          }
+        }
+      }
+    } catch (_: Exception) {
+      main.post {
+        if (generation.get() == token) {
+          stop()
+          status.text = "Camera unavailable. Stop, then Start to retry."
+        }
+      }
+    } finally {
+      connection.compareAndSet(socket, null)
+      socket?.disconnect()
+    }
+  }
+
+  fun stop() {
+    active = false; generation.incrementAndGet(); pending.set(null)
+    image.setImageDrawable(null); status.text = "Camera stopped"
+    connection.getAndSet(null)?.let { socket ->
+      Thread({ socket.disconnect() }, "gladiator-camera-close").apply { isDaemon = true; start() }
+    }
+  }
+
+  fun dispose() { stop(); reactContext.removeLifecycleEventListener(this) }
+  override fun onDetachedFromWindow() { stop(); super.onDetachedFromWindow() }
+  override fun onHostPause() { stop() }
+  override fun onHostResume() {} // No automatic restart or reconnect.
+  override fun onHostDestroy() { stop() }
+}
+
+class GladiatorCameraViewManager : SimpleViewManager<GladiatorCameraView>() {
+  override fun getName() = "GladiatorCameraView"
+  override fun createViewInstance(context: ThemedReactContext) = GladiatorCameraView(context)
+  @ReactProp(name = "active", defaultBoolean = false)
+  fun setActive(view: GladiatorCameraView, active: Boolean) { view.setActive(active) }
+  override fun onDropViewInstance(view: GladiatorCameraView) { view.dispose(); super.onDropViewInstance(view) }
+}
