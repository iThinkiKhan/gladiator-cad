+import React, {useEffect, useState} from 'react';
+import {AppState, Platform, Pressable, requireNativeComponent, StyleSheet, Text, View, type ViewProps} from 'react-native';
+import {theme} from '../theme/theme';
+
+const CameraView = Platform.OS === 'android'
+  ? requireNativeComponent<ViewProps & {active: boolean}>('GladiatorCameraView')
+  : null;
+
+// Independent read-only Wi-Fi viewer. No motor/arm/mast commands or credentials.
+export function GladiatorCamera() {
+  const [playing, setPlaying] = useState(false);
+  useEffect(() => {
+    const listener = AppState.addEventListener('change', state => {
+      if (state !== 'active') setPlaying(false);
+    });
+    return () => listener.remove();
+  }, []);
+  return <View style={styles.panel}>
+    <View style={styles.row}>
+      <Text style={styles.title}>Gladiator camera</Text>
+      <Pressable accessibilityRole="button" accessibilityLabel={playing ? 'Stop video' : 'Start video'}
+        disabled={!CameraView} onPress={() => setPlaying(value => !value)} style={styles.button}>
+        <Text style={styles.buttonText}>{playing ? 'Stop video' : 'Start video'}</Text>
+      </Pressable>
+    </View>
+    {playing && CameraView ? <CameraView active={true} style={styles.video} /> : null}
+    <Text style={styles.note}>Join Gladiator-Gateway Wi-Fi for video. Drive uses BLE. One video viewer at a time.</Text>
+  </View>;
+}
+
+const styles = StyleSheet.create({
+  panel: {backgroundColor: theme.colors.panel, borderRadius: theme.radius.md, padding: 8, gap: 6},
+  row: {flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', gap: 8},
+  title: {color: theme.colors.textStrong, fontSize: 13, fontWeight: '700'},
+  button: {minHeight: 44, paddingHorizontal: 12, justifyContent: 'center', backgroundColor: theme.colors.chrome, borderRadius: theme.radius.md},
+  buttonText: {color: theme.colors.cyan, fontWeight: '700'},
+  video: {height: 180, width: '100%'},
+  note: {color: theme.colors.textSoft, fontSize: 11, lineHeight: 15},
+});
