+public class MjpegReaderTest {
+  static int checked=0;
+  static final byte[] JPEG={(byte)255,(byte)216,1,2,(byte)255,(byte)217};
+  static byte[] part(String header,byte[] jpeg) throws Exception {
+    ByteArrayOutputStream out=new ByteArrayOutputStream();
+    out.write(header.getBytes(StandardCharsets.US_ASCII));out.write(jpeg);return out.toByteArray();
+  }
+  static MjpegReader reader(byte[] bytes) throws IOException {
+    return new MjpegReader(new ByteArrayInputStream(bytes),"multipart/x-mixed-replace;boundary=cam");
+  }
+  static void reject(byte[] bytes) throws Exception {
+    try {reader(bytes).readFrame();throw new AssertionError("Invalid frame accepted");}
+    catch(IOException expected){checked++;}
+  }
+  public static void main(String[] args) throws Exception {
+    String header="\r\n--cam\r\nContent-Type: image/jpeg\r\nContent-Length: 6\r\nX-Timestamp: 1\r\n\r\n";
+    byte[] frame=part(header,JPEG);ByteArrayOutputStream stream=new ByteArrayOutputStream();stream.write(frame);stream.write(frame);
+    MjpegReader r=reader(stream.toByteArray());
+    assert Arrays.equals(r.readFrame(),JPEG);assert Arrays.equals(r.readFrame(),JPEG);checked+=2;
+    reject(part(header,new byte[]{(byte)255,(byte)216}));
+    reject(part(header,new byte[]{0,0,0,0,0,0}));
+    for(String invalid:new String[]{
+      "--cam\r\nContent-Type: image/jpeg\r\n\r\n",
+      "--cam\r\nContent-Type: text/html\r\nContent-Length: 6\r\n\r\n",
+      "--cam\r\nContent-Type: image/jpeg\r\nContent-Length: 262145\r\n\r\n",
+      "--cam\r\nContent-Type: image/jpeg\r\nContent-Length: 6\r\nContent-Length: 6\r\n\r\n",
+      "--cam\r\nContent-Type: image/jpeg\r\nContent-Length: -6\r\n\r\n",
+      "--wrong\r\n","--cam--\r\n","--cam\r\n"+"X".repeat(513)+"\r\n"}) reject(part(invalid,JPEG));
+    try {new MjpegReader(new ByteArrayInputStream(frame),"text/html");throw new AssertionError();}catch(IOException expected){checked++;}
+    assert Arrays.equals(new MjpegReader(new ByteArrayInputStream(frame),"multipart/x-mixed-replace; boundary=\"cam\"").readFrame(),JPEG);checked++;
+    System.out.println("Camera reader: "+checked+" cases passed (multipart, timestamps, truncation, bad JPEG, bounds and headers).");
+  }
+}
