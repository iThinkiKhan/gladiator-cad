+package com.spectre.companion;
+
+import java.io.EOFException;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Locale;
+
+/** Bounded multipart reader for the existing ESP32-CAM JPEG stream. */
+public final class MjpegReader {
+  private static final int MAX_JPEG = 262144;
+  private final InputStream input;
+  private final String boundary;
+
+  public MjpegReader(InputStream input, String contentType) throws IOException {
+    this.input = input;
+    if (contentType == null || !contentType.toLowerCase(Locale.ROOT).startsWith("multipart/x-mixed-replace"))
+      throw new IOException("Expected camera MJPEG stream");
+    String found = null;
+    for (String part : contentType.split(";")) {
+      String value = part.trim();
+      if (value.toLowerCase(Locale.ROOT).startsWith("boundary=")) {
+        found = value.substring(9).trim();
+        if (found.startsWith("\"") && found.endsWith("\"")) found = found.substring(1, found.length()-1);
+      }
+    }
+    if (found == null || !found.matches("[a-zA-Z0-9_-]{1,80}")) throw new IOException("Invalid camera boundary");
+    boundary = "--" + found;
+  }
+
+  private String line() throws IOException {
+    StringBuilder out = new StringBuilder();
+    for (int n=0; n<512; n++) {
+      int value = input.read();
+      if (value<0) throw new EOFException("Camera disconnected");
+      if (value=='\n') return out.toString().replace("\r", "");
+      if (value>127 || (value<32 && value!='\r')) throw new IOException("Invalid camera header");
+      out.append((char)value);
+    }
+    throw new IOException("Camera header too long");
+  }
+
+  public byte[] readFrame() throws IOException {
+    String marker = line();
+    for (int n=0; marker.isEmpty() && n<8; n++) marker=line();
+    if (!marker.equals(boundary)) throw new IOException("Camera boundary missing");
+    int length=-1, total=0;
+    boolean jpeg=false;
+    for (int n=0; n<32; n++) {
+      String header=line(); total+=header.length();
+      if (total>4096) throw new IOException("Camera headers too large");
+      if (header.isEmpty()) {
+        if (!jpeg || length<4 || length>MAX_JPEG) throw new IOException("Invalid JPEG length/type");
+        byte[] bytes=new byte[length]; int used=0;
+        while (used<length) {
+          int got=input.read(bytes,used,length-used);
+          if (got<=0) throw new EOFException("Incomplete camera frame");
+          used+=got;
+        }
+        if ((bytes[0]&255)!=255 || (bytes[1]&255)!=216 ||
+            (bytes[length-2]&255)!=255 || (bytes[length-1]&255)!=217) throw new IOException("Invalid JPEG frame");
+        return bytes;
+      }
+      int colon=header.indexOf(':');
+      if (colon<1) throw new IOException("Malformed camera header");
+      String key=header.substring(0,colon).trim().toLowerCase(Locale.ROOT);
+      String value=header.substring(colon+1).trim();
+      if (key.equals("content-type")) jpeg=value.equalsIgnoreCase("image/jpeg");
+      if (key.equals("content-length")) {
+        if (length!=-1 || !value.matches("[0-9]{1,6}")) throw new IOException("Invalid camera length");
+        length=Integer.parseInt(value);
+      }
+    }
+    throw new IOException("Too many camera headers");
+  }
+}
